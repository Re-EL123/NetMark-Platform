# Driver app (driver-app) — Expo reads EXPO_PUBLIC_* automatically. These are
# public values bundled into the app; do not put secrets here.

# Supabase project URL (Project Settings → API → Project URL)
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase anon public key (SAFE for clients; its JWT role must be "anon")
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Base URL of the API (no trailing slash)
API_URL=https://netmark-api.vercel.app/api
