# API (apps/api) — set these in Vercel (Project → Settings → Environment Variables)
# and/or in apps/api/.env.local for local `vercel dev`.

# Supabase project URL (Project Settings → API → Project URL)
SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase service_role key (SECRET — server only, never ship to browsers)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
