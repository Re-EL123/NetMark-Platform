# API (apps/api) — set these in Vercel (Project → Settings → Environment Variables)
# and/or in apps/api/.env.local for local `vercel dev`.

# Supabase project URL (Project Settings → API → Project URL)
SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase service_role key (SECRET — server only, never ship to browsers)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---- PayFast (custom integration) ----
# Sandbox credentials come from https://sandbox.payfast.co.za (Settings → Integration).
# "true" uses the PayFast sandbox; set to "false" for live.
PAYFAST_SANDBOX=true
PAYFAST_MERCHANT_ID=your-merchant-id
PAYFAST_MERCHANT_KEY=your-merchant-key
PAYFAST_PASSPHRASE=your-passphrase
# Browser redirect URLs after a payment attempt
PAYFAST_RETURN_URL=https://netmark.re-el.co.za/shop/?payment=success
PAYFAST_CANCEL_URL=https://netmark.re-el.co.za/shop/?payment=cancelled
# Public URL of this API (used to build the ITN notify URL if not set explicitly)
API_PUBLIC_URL=https://api.netmark.re-el.co.za
PAYFAST_NOTIFY_URL=https://api.netmark.re-el.co.za/api/payments/payfast/notify

# ---- Email (Resend) ----
RESEND_API_KEY=re_your_resend_api_key
EMAIL_FROM="NetMark <no-reply@re-el.co.za>"
APP_URL=https://netmark.re-el.co.za

# ---- Storefront SSR (/s/<slug>) ----
# Public base URL used to build canonical + share links for server-rendered
# storefront pages. Falls back to API_PUBLIC_URL, then https://shop.netmark.re-el.co.za.
# Set this to a BRANDED host (a custom domain on this Vercel project) so shared
# links don't expose the *.vercel.app API host.
STOREFRONT_BASE_URL=https://shop.netmark.re-el.co.za

# Host that serves the static web app (GitHub Pages). The SSR handler fetches
# its HTML shell from here and rebases asset URLs. Defaults to https://netmark.re-el.co.za.
WEB_BASE_URL=https://netmark.re-el.co.za

# ---- Cron (autoship runner) ----
# Vercel Cron sends `Authorization: Bearer $CRON_SECRET`. Set a random secret to
# protect /api/cron/autoship; if unset only Vercel's own cron header is accepted.
CRON_SECRET=your-random-cron-secret
