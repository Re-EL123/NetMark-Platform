{
  "version": 2,
  "installCommand": "npm install --no-workspaces",
  "rewrites": [
    { "source": "/s/(.*)", "destination": "/api/index" },
    { "source": "/s", "destination": "/api/index" },
    { "source": "/api/(.*)", "destination": "/api/index" }
  ],
  "functions": {
    "api/index.ts": {
      "maxDuration": 10
    }
  },
  "crons": [
    { "path": "/api/cron/autoship", "schedule": "0 6 * * *" },
    { "path": "/api/cron/commissions", "schedule": "0 7 * * *" },
    { "path": "/api/cron/plans", "schedule": "0 8 * * *" },
    { "path": "/api/cron/memberships", "schedule": "0 9 * * *" }
  ]
}
