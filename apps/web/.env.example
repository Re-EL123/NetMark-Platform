# Web (apps/web) — set these as GitHub Actions secrets (repo or the
# `github-pages` environment) for the Pages build, and/or in apps/web/.env.local
# for local dev. These are public values baked into the browser bundle.

# Base URL of the API (no trailing slash)
VITE_API_BASE_URL=https://api.netmark.re-el.co.za/api

# Supabase project URL (Project Settings → API → Project URL)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase anon public key (SAFE for browsers; its JWT role must be "anon")
VITE_SUPABASE_ANON_KEY=your-anon-public-key
